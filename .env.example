# --- Database (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DB=casehub
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
DATABASE_URL=mysql+pymysql://app_user:changeme@db:3306/casehub
# Same database, but reachable from the host machine (used by Alembic and
# other tools run outside Docker) — "db" is only a valid hostname inside
# the Docker network, "localhost" is what your Windows machine understands.
DATABASE_URL_LOCAL=mysql+pymysql://app_user:changeme@localhost:3306/casehub
# Separate database for pytest — same MySQL server, different schema, so
# tests never touch real dev data. pytest run outside Docker, so this uses
# "localhost" like DATABASE_URL_LOCAL above. Create it once with:
#   docker exec <db-container> mysql -uroot -p -e "CREATE DATABASE IF NOT EXISTS casehub_test; GRANT ALL PRIVILEGES ON casehub_test.* TO 'app_user'@'%';"
TEST_DATABASE_URL=mysql+pymysql://app_user:changeme@localhost:3306/casehub_test

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Session cookies are scoped to BASE_DOMAIN so one login works across every
# subdomain. COOKIE_SECURE must be false for local http dev, true in
# production (https only).
COOKIE_SECURE=false

# --- Base domain for subdomain tenant resolution ---
# e.g. lvh.me for local dev (any subdomain resolves to localhost). Also
# drives CORS: every origin matching https?://<subdomain>.BASE_DOMAIN is
# trusted automatically (allow_origin_regex), since tenant subdomains are
# created dynamically at signup and can't be hand-listed.
BASE_DOMAIN=lvh.me

# --- File storage (local disk, behind storage abstraction) ---
# Resolved by shared/storage.py inside the client_api/admin_api containers,
# whose WORKDIR (/app) is a bind-mount of this repo's ./server directory
# (see docker-compose.yml) — so this path is relative to ./server, not the
# repo root. "./server/storage" here would double-resolve to a nested
# ./server/server/storage on the host, which is exactly the bug this was
# fixed from (see docs/ai_usage.md).
STORAGE_ROOT=./storage

# --- Cross-app links (admin_api needs this one; client_api never needs
# admin/'s port, since invites/dev-outbox links only ever point *into*
# client/) ---
# An invite's dev-outbox link points at http://<tenant-subdomain>.BASE_DOMAIN:
# CLIENT_APP_PORT/register — admin_api already knows the subdomain (it's the
# inviting tenant), but not client/'s port: that request's own Origin header
# is admin/'s, not client/'s, unlike forgot-password's link (built from the
# *calling* app's own Origin).
CLIENT_APP_PORT=5173

# --- App ---
APP_ENV=development

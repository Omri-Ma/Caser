# --- Database (MySQL) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DB=multivendor_hub
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme
DATABASE_URL=mysql+pymysql://app_user:changeme@db:3306/multivendor_hub

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://client.lvh.me:5173,http://admin.lvh.me:5174

# --- Base domain for subdomain tenant resolution ---
# e.g. lvh.me for local dev (any subdomain resolves to localhost)
BASE_DOMAIN=lvh.me

# --- File storage (local disk, behind storage abstraction) ---
STORAGE_ROOT=./server/storage

# --- App ---
APP_ENV=development

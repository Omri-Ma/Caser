# The client app is always reached at a tenant subdomain (e.g.
# office1.lvh.me:5173) — the API base URL reuses that same hostname (see
# src/api/client.js) and only needs protocol/port from env, not a full URL.
VITE_API_PROTOCOL=http
VITE_API_PORT=8000
# Needed only for the lobby login (www.lvh.me:5173) redirecting a lawyer/
# client to the tenant subdomain they picked/were matched to — the app
# doesn't already know its own subdomain there (see src/utils/host.js).
VITE_BASE_DOMAIN=lvh.me
# admin/'s lobby port — used to link out to admin/'s signup page (founding a
# firm) from client/'s homepage and lobby login, since that's a cross-app
# link and admin/ is reached at a different port locally (see
# src/utils/host.js's adminSignupUrl()).
VITE_ADMIN_APP_PORT=5174

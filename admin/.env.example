# The admin app is always reached at a tenant subdomain (e.g.
# office1.lvh.me:5174) — the API base URL reuses that same hostname (see
# src/api/client.js) and only needs protocol/port from env, not a full URL.
VITE_API_PROTOCOL=http
VITE_API_PORT=8001
# Needed only for the one flow where the app doesn't already know its own
# subdomain: after founding a new firm, SignupPage hard-redirects to the new
# tenant's own subdomain rather than staying on whatever host the signup
# form happened to be loaded from (see src/pages/SignupPage.jsx).
VITE_BASE_DOMAIN=lvh.me
# client/'s lobby port — used to link out to client/'s login page from
# admin/'s lobby login, for a lawyer/client who landed there by mistake
# (cross-app link, different port locally — see src/utils/host.js's
# clientLoginUrl()).
VITE_CLIENT_APP_PORT=5173

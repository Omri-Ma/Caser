    "/cases/{case_id}/work-logs": {
      "post": {
        "tags": [
          "work-logs"
        ],
        "summary": "Create Work Log",
        "description": "Manual entry — the case must be one this lawyer is currently assigned\nto, and not closed (CLAUDE.md: a closed case blocks new WorkLogs the same\nway it blocks new Documents).",
        "operationId": "create_work_log_cases__case_id__work_logs_post",

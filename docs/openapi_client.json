        ],
        "summary": "Restore Document",
        "description": "Lawyer-only — clients can't restore anything, even their own, same\nasymmetry as everywhere else (they'd ask a lawyer).",
        "operationId": "restore_document_cases__case_id__documents__document_id__restore_post",

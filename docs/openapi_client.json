          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/documents/{document_id}/archive": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Archive Document",
        "description": "Client: own uploads only. Lawyer: any document on this (assigned)\ncase, their own or a colleague's — same broad, collaborative authority\nused elsewhere on a shared case record.",
        "operationId": "archive_document_cases__case_id__documents__document_id__archive_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/documents/{document_id}/restore": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Restore Document",
        "description": "Lawyer-only — clients can't restore anything, even their own, same\nasymmetry as everywhere else (they'd ask a lawyer).",
        "operationId": "restore_document_cases__case_id__documents__document_id__restore_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/documents/{document_id}": {
      "patch": {
        "tags": [
          "documents"
        ],
        "summary": "Reclassify Document",
        "description": "Lawyer-only, never client — moving your own upload into internal\nwould just make it invisible to yourself, so it's meaningless as a\nclient action anyway.",
        "operationId": "reclassify_document_cases__case_id__documents__document_id__patch",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Document Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReclassifyDocumentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {

      "patch": {
        "tags": [
          "documents"
        ],
        "summary": "Reclassify Document",
        "description": "Lawyer-only, never client — moving your own upload into internal\nwould just make it invisible to yourself, so it's meaningless as a\nclient action anyway.",
        "operationId": "reclassify_document_cases__case_id__documents__document_id__patch",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"

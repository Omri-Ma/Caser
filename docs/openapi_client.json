    "/cases/{case_id}/work-logs/{work_log_id}": {
      "patch": {
        "tags": [
          "work-logs"
        ],
        "summary": "Update Work Log",
        "description": "Any lawyer assigned to the case can edit any entry on it, not just\ntheir own (CLAUDE.md: same broad, collaborative authority as Documents).\nLocked entirely once the case is closed — same cutoff as creating new\nentries, one consistent \"closed means frozen\" rule. Every edit is logged\nin AuditLogs (who changed which entry, when — not before/after values).",
        "operationId": "update_work_log_cases__case_id__work_logs__work_log_id__patch",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,

  "components": {
    "schemas": {
      "Body_upload_document_cases__case_id__documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "folder_type": {
            "$ref": "#/components/schemas/DocumentFolderType"
          },
          "confirm_replace": {
            "type": "boolean",
            "title": "Confirm Replace",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file",
          "folder_type"
        ],
        "title": "Body_upload_document_cases__case_id__documents_post"
      },
      "CaseResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "tenant_id": {
            "type": "integer",
            "title": "Tenant Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "title",
          "status",
          "created_at"
        ],
        "title": "CaseResponse"
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "on_hold",
          "closed"
        ],
        "title": "CaseStatus"
      },
      "CreateWorkLogRequest": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "hours": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 24.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Hours"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "date",
          "hours"
        ],
        "title": "CreateWorkLogRequest"
      },
      "DocumentFolderType": {
        "type": "string",
        "enum": [
          "client",
          "internal"
        ],
        "title": "DocumentFolderType"
      },
      "DocumentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "case_id": {
            "type": "integer",
            "title": "Case Id"
          },
          "folder_type": {
            "$ref": "#/components/schemas/DocumentFolderType"
          },
          "original_filename": {
            "type": "string",
            "title": "Original Filename"
